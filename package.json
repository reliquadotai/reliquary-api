{
  "name": "@reliquary/api",
  "version": "0.11.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jobctl": "bin/jobctl.mjs",
    "reliqua": "bin/reliqua.mjs"
  },
  "description": "Versioned generation, job and evaluation contracts and clients",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./batch-orders": {
      "types": "./dist/batch-orders.d.ts",
      "import": "./dist/batch-orders.js"
    },
    "./batch-files": {
      "types": "./dist/batch-files.d.ts",
      "import": "./dist/batch-files.js"
    },
    "./node": {
      "types": "./dist/batch-node.d.ts",
      "import": "./dist/batch-node.js"
    },
    "./product-inventory": {
      "types": "./dist/product-inventory.d.ts",
      "import": "./dist/product-inventory.js"
    },
    "./openapi": "./contracts/generation.openapi.json",
    "./jobs": {
      "types": "./dist/job-api.d.ts",
      "import": "./dist/job-api.js"
    },
    "./subnet-tasks": {
      "types": "./dist/subnet-tasks.d.ts",
      "import": "./dist/subnet-tasks.js"
    },
    "./jobs/openapi": "./contracts/jobs.openapi.json",
    "./evaluations": {
      "types": "./dist/evaluation-api.d.ts",
      "import": "./dist/evaluation-api.js"
    },
    "./evaluations/openapi": "./contracts/evaluations.openapi.json",
    "./subnet-client": {
      "types": "./dist/subnet-client.d.ts",
      "import": "./dist/subnet-client.js"
    },
    "./affine-pilot": {
      "types": "./dist/affine-pilot.d.ts",
      "import": "./dist/affine-pilot.js"
    },
    "./affine-pilot/openapi": "./contracts/affine-pilot.openapi.json",
    "./affine-batches": {
      "types": "./dist/affine-batches.d.ts",
      "import": "./dist/affine-batches.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "bin",
    "examples",
    "README.md",
    "skills",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-skills.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
