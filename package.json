{
  "name": "@reliquary/api",
  "version": "0.2.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "jobctl": "bin/jobctl.mjs" },
  "description": "Versioned generation and job contracts and clients",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./batch-orders": {
      "types": "./dist/batch-orders.d.ts",
      "import": "./dist/batch-orders.js"
    },
    "./product-inventory": {
      "types": "./dist/product-inventory.d.ts",
      "import": "./dist/product-inventory.js"
    },
    "./openapi": "./contracts/generation.openapi.json",
    "./jobs": {
      "types": "./dist/job-api.d.ts",
      "import": "./dist/job-api.js"
    },
    "./subnet-tasks": {
      "types": "./dist/subnet-tasks.d.ts",
      "import": "./dist/subnet-tasks.js"
    },
    "./jobs/openapi": "./contracts/jobs.openapi.json",
    "./subnet-client": {
      "types": "./dist/subnet-client.d.ts",
      "import": "./dist/subnet-client.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
